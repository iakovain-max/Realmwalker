    "fiendish_spirit": {"name": "fiendish spirit", "plural": "fiendish spirits", "body": "humanoid", "morale": "fanatic", "ai": {"role": "brute"}, "summon": {"spell": "summon_fiend", "level": 6, "ac": 12, "hp": 50, "hp_up": 15, "forms": {"demon": {"name": "demon spirit", "picture": "fiend_demon", "attacks": ["bite"], "speeds": {"climb": 40}, "traits": ["death_throes"], "likes": ["many"]}, "devil": {"name": "devil spirit", "picture": "fiend_devil", "hp": 40, "attacks": ["fiery_strike"], "speeds": {"fly": 60}, "traits": ["devils_sight"], "likes": ["far", "aloft"]}, "yugoloth": {"name": "yugoloth spirit", "picture": "fiend_yugoloth", "hp": 60, "attacks": ["claws"], "traits": ["yugoloth_step"], "weight": 1.1}}}, "descriptions": ["A fiend called up from the pits, held to its caster by a thread of will and nothing more.", "It grins at its caster's foes and at its caster alike."], "statblock": "fiendish_spirit", "butcher": [], "gear": [], "traits": []},
    "animated_object": {"name": "animated object", "plural": "animated objects", "body": "quadruped", "morale": "mindless", "ai": {"role": "brute"}, "summon": {"spell": "animate_objects", "level": 5, "ac": 15, "hp": 10, "hp_up": 0, "multiattack": false, "sizes": {"medium": {"count": 1, "hp": 10, "damage": "1d4+3", "up": "1d4", "in": {"name": "animated chest", "picture": "animated_chest"}, "out": {"name": "animated stone", "picture": "animated_stone"}}, "large": {"count": 2, "hp": 20, "damage": "2d6+3", "mod": true, "up": "1d6", "in": {"name": "animated table", "picture": "animated_table"}, "out": {"name": "animated log", "picture": "animated_log"}}, "huge": {"count": 3, "hp": 40, "damage": "2d12+3", "mod": true, "up": "1d12", "in": {"name": "animated statue", "picture": "animated_statue"}, "out": {"name": "animated boulder", "picture": "animated_boulder"}}}}, "descriptions": ["A thing that should lie still, walking on legs it did not have a moment ago.", "It lurches at its maker's foes with the blind obedience of something that never had a will."], "statblock": "animated_object", "butcher": [], "gear": [], "traits": []},
    "ghast": {"statblock": "ghast", "name": "ghast", "plural": "ghasts", "body": "humanoid", "morale": "mindless", "ai": {"role": "brute"}, "loot": [], "gear": [], "attack_extras": {"bite": {"wound": "bite", "disease": "grave_rot"}}, "traits": ["undead"], "descriptions": ["A ghoul grown old in its hunger, grey skin drawn tight over a grin of black teeth. The reek of it reaches you before it does.", "It moves like a beggar and stinks like a charnel pit, and its claws leave the limbs they touch dead to the bone."]},
    "mummy": {"statblock": "mummy", "name": "mummy", "plural": "mummies", "body": "humanoid", "morale": "mindless", "ai": {"role": "brute", "opens_with": "dreadful_glare"}, "loot": [], "gear": [], "attack_extras": {"rotting_fist": {"wound": "bruise"}}, "traits": ["undead"], "descriptions": ["A body bound in brown linen and older resins, slow on its feet, its eyes two coals in a face gone to leather.", "It smells of tar, dust and something sweet beneath, and where its fists strike, the flesh begins to rot."]}
