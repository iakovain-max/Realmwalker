  "encounters": {
    "raised_dead": {"name": "the dead you raised", "members": [["zombie", "1"]], "biomes": ["none"], "danger": [0, 10], "time": "any", "weight": 0, "intro": ["The dead you raised stop where they stand. Then, all at once, they turn to face you.", "Your hold on the dead slips like a wet rope, and the things that served you remember what they hate.", "Something goes out of the air between you and your dead, and they come for you, slow and sure."]}
