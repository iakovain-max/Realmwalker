    "undead_spirit": {"name": "undead spirit", "plural": "undead spirits", "body": "humanoid", "morale": "mindless", "ai": {"role": "brute"}, "summon": {"spell": "summon_undead", "level": 3, "ac": 11, "hp": 30, "hp_up": 10, "forms": {"putrid": {"name": "putrid spirit", "picture": "ghoul", "attacks": ["rotting_claw"], "traits": ["festering_aura"], "weight": 1.2}, "ghostly": {"name": "ghostly spirit", "picture": "ghost", "attacks": ["deathly_touch"], "speeds": {"fly": 40, "hover": true}, "traits": ["incorporeal_passage"], "likes": ["aloft"]}, "skeletal": {"name": "skeletal spirit", "picture": "skeleton", "hp": 20, "attacks": ["grave_bolt"], "likes": ["far", "aloft"]}}}, "descriptions": ["A dead thing called back for a while: a reeking corpse, a cold shade or a rattling skeleton.", "It serves without a word, and the air around it smells of the grave."], "statblock": "undead_spirit", "butcher": [], "gear": [], "traits": []},
