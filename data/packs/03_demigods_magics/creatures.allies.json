{
  "_comment": "Expansion 3 part F.1: the creatures that fight for the party (game/allies.py). Never met in the wild. F.4: the ghast and the mummy of Create Undead, and the encounter of the raised dead gone free (game/servants.tick).",
  "creatures": {
    "otherworldly_steed": {"statblock": "otherworldly_steed", "name": "steed", "plural": "steeds", "body": "quadruped", "morale": "beast", "ai": {"role": "brute"}, "butcher": [], "gear": [], "traits": [], "descriptions": ["A steed that is not quite of this world: its eyes hold another light, and it waits on its rider's thought.", "It stands too still for a living animal, and the air around it smells of somewhere else."]},
    "bestial_spirit": {"name": "bestial spirit", "plural": "bestial spirits", "body": "quadruped", "morale": "beast", "ai": {"role": "brute"}, "summon": {"spell": "summon_beast", "level": 2, "ac": 11, "hp": 30, "hp_up": 5, "forms": {"land": {"name": "bestial spirit of the land", "picture": "wolf", "speeds": {"climb": 30}, "traits": ["pack_tactics"]}, "air": {"name": "bestial spirit of the air", "picture": "hawk", "hp": 20, "speeds": {"fly": 60}, "traits": ["flyby"], "likes": ["aloft"]}, "water": {"name": "bestial spirit of the water", "picture": "shark", "speeds": {"swim": 30}, "traits": ["pack_tactics", "water_breathing"], "likes": ["water"]}}}, "descriptions": ["A beast that is more than a beast: the shape of a wolf, a hawk or a shark, drawn in the colours of somewhere wilder.", "It moves as an animal does, but it watches its caster for a sign."], "statblock": "bestial_spirit", "butcher": [], "gear": [], "traits": []},
