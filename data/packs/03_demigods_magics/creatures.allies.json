    "construct_spirit": {"name": "construct spirit", "plural": "construct spirits", "body": "humanoid", "morale": "mindless", "ai": {"role": "brute"}, "summon": {"spell": "summon_construct", "level": 4, "ac": 13, "hp": 40, "hp_up": 15, "forms": {"metal": {"name": "metal construct spirit", "picture": "iron_golem", "traits": ["heated_body"], "weight": 1.1}, "stone": {"name": "stone construct spirit", "picture": "stone_golem", "traits": ["stony_lethargy"], "likes": ["many"]}, "clay": {"name": "clay construct spirit", "picture": "clay_golem", "traits": ["berserk_lashing"]}}}, "descriptions": ["A statue that walks: clay, metal or stone shaped like a soldier, a spirit burning in its eyes.", "Its joints grind as it turns to its maker for the next command."], "statblock": "construct_spirit", "butcher": [], "gear": [], "traits": []},
    "elemental_spirit": {"name": "elemental spirit", "plural": "elemental spirits", "body": "humanoid", "morale": "mindless", "ai": {"role": "brute"}, "summon": {"spell": "summon_elemental", "level": 4, "ac": 11, "hp": 50, "hp_up": 10, "forms": {"earth": {"name": "earth spirit", "picture": "earth_elemental", "damage_type": "bludgeoning", "speeds": {"burrow": 40}, "resist": ["piercing", "slashing"], "weight": 1.1}, "air": {"name": "air spirit", "picture": "air_elemental", "damage_type": "lightning", "speeds": {"fly": 40, "hover": true}, "resist": ["lightning", "thunder"], "traits": ["amorphous_form"], "likes": ["aloft"]}, "fire": {"name": "fire spirit", "picture": "fire_elemental", "damage_type": "fire", "immune": ["fire"], "traits": ["amorphous_form"]}, "water": {"name": "water spirit", "picture": "water_elemental", "damage_type": "cold", "speeds": {"swim": 40}, "resist": ["acid"], "traits": ["amorphous_form"]}}}, "descriptions": ["A shape of two legs and two arms wreathed in its element: stone, storm, flame or wave.", "It is the element made willing, for as long as the spell holds."], "statblock": "elemental_spirit", "butcher": [], "gear": [], "traits": []},
    "giant_insect": {"name": "giant insect", "plural": "giant insects", "body": "spider", "morale": "beast", "ai": {"role": "brute"}, "summon": {"spell": "giant_insect", "level": 4, "ac": 11, "hp": 70, "hp_up": 10, "forms": {"centipede": {"name": "giant centipede", "picture": "giant_centipede", "attacks": ["poison_jab"], "spells": ["venomous_spew"], "weight": 1.1}, "spider": {"name": "giant spider", "picture": "giant_spider", "attacks": ["poison_jab", "web_bolt"], "likes": ["far"]}, "wasp": {"name": "giant wasp", "picture": "giant_wasp", "attacks": ["poison_jab"], "speeds": {"fly": 40}, "likes": ["aloft"]}}}, "descriptions": ["An insect the size of a horse, conjured whole: a centipede, a spider or a wasp.", "Its jaws click as it waits for its caster's word."], "statblock": "giant_insect", "butcher": [], "gear": [], "traits": []},
    "celestial_spirit": {"name": "celestial spirit", "plural": "celestial spirits", "body": "humanoid", "morale": "fanatic", "ai": {"role": "brute"}, "summon": {"spell": "summon_celestial", "level": 5, "ac": 11, "hp": 40, "hp_up": 10, "per_day": {"1": ["celestial_healing_touch"]}, "forms": {"avenger": {"name": "avenging celestial spirit", "picture": "celestial_avenger", "attacks": ["radiant_bow"], "likes": ["far", "aloft"], "weight": 1.1}, "defender": {"name": "defending celestial spirit", "picture": "celestial_defender", "attacks": ["radiant_mace"], "ac": 2, "likes": ["brawl"]}}}, "descriptions": ["A winged figure in burning armour, its face hidden behind a helm of light.", "It looks to its caster as a soldier looks to a captain, and shines on whatever it means to strike."], "statblock": "celestial_spirit", "butcher": [], "gear": [], "traits": []},
