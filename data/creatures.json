  "encounters": {
    "town_watch": {"name": "the town watch", "members": [["guard", "1d2+1"]], "biomes": ["none"], "danger": [0, 10], "time": "any", "weight": 0,
      "intro": ["\"Watch! Stand where you are!\"", "Boots behind you, and a hand on your shoulder. \"You. A word.\"", "The watch comes round the corner four abreast and stops when they see you."]},
    "angry_townsfolk": {"name": "angry townsfolk", "members": [["commoner", "1"]], "biomes": ["none"], "danger": [0, 10], "time": "any", "weight": 0,
      "intro": ["They come at you, shouting.", "A crowd has decided something about you, and it has decided fast.", "Someone points, someone shouts your name, and the street empties towards you."]},
    "lone_wolf": {"name": "a lone wolf", "members": [["wolf", "1"]], "biomes": ["forest", "pine_forest", "hills", "tundra", "plains", "mountains"], "danger": [0, 3], "time": "any", "weight": 2,
                   "intro": ["A wolf breaks from the trees and comes at you low and fast.", "A wolf has been following you for a mile. It has stopped following.", "One wolf, alone and thin, steps into the road and will not give it up."]},
    "wolf_pack": {"name": "a pack of wolves", "members": [["wolf", "1d2+1"]], "biomes": ["forest", "pine_forest", "hills", "tundra", "plains", "mountains"], "danger": [2, 7], "time": "any", "weight": 3,
                   "intro": ["Wolves: grey shapes on either side of you, and one more behind.", "A howl, close. Then another, closer. The pack has found you.", "The horses would be screaming, if you had horses. Wolves, and they have chosen their ground.", "You count four before you stop counting."]},
    "dire_wolves": {"name": "dire wolves", "members": [["dire_wolf", "1d2"]], "biomes": ["pine_forest", "tundra", "hills", "mountains"], "danger": [6, 10], "time": "any", "weight": 2,
                   "intro": ["Wolves as big as ponies step out of the dark and do not hurry.", "Something the size of a horse moves at the edge of the trees, and then a second one does.", "They come at a walk, which is worse than a run: they are in no doubt."]},
    "wild_dogs": {"name": "wild dogs", "members": [["wild_dog", "1d2+1"]], "biomes": ["plains", "hills", "coast", "desert", "marsh"], "danger": [0, 4], "time": "any", "weight": 2,
                   "intro": ["A pack of starving dogs, ribs like fingers, circles you and closes in.", "The dogs have been eating something they should not have, and they want more of it.", "A dozen dogs, half wild, cut off the road behind and in front."]},
    "boar": {"name": "a wild boar", "members": [["boar", "1"]], "biomes": ["forest", "pine_forest", "hills"], "danger": [1, 5], "time": "day", "weight": 2,
                   "intro": ["The undergrowth explodes and a boar charges straight at you.", "A boar, old and scarred, plants itself in the path and lowers its head.", "You hear it before you see it, and then there is no time for seeing."]},
    "bear": {"name": "a bear", "members": [["black_bear", "1"]], "biomes": ["forest", "pine_forest", "hills", "mountains"], "danger": [3, 7], "time": "day", "weight": 1,
                   "intro": ["A bear rises from a thicket not ten yards off, and it does not like you.", "A bear stands up out of the bracken and looks down at you.", "The bear is between you and the way out, and it knows it."]},
    "brown_bear": {"name": "a brown bear", "members": [["brown_bear", "1"]], "biomes": ["pine_forest", "hills", "mountains", "tundra"], "danger": [5, 10], "time": "day", "weight": 1,
                   "intro": ["A brown bear, huge and hungry after winter, comes at you from the rocks.", "A brown bear with cubs somewhere behind it. That is the worst kind.", "It comes down off the rocks in three strides and none of them are slow."]},
    "rats": {"name": "giant rats", "members": [["giant_rat", "1d3+1"]], "biomes": ["marsh", "coast", "plains"], "danger": [0, 4], "time": "night", "weight": 2,
                   "intro": ["Red eyes in the dark, and the chitter of something far too big to be a rat.", "The floor moves. All of it.", "Something squeals, and the dark answers with a hundred squeals."]},
    "footpads": {"name": "footpads", "members": [["bandit", "2"]], "biomes": ["any"], "danger": [0, 3], "time": "any", "weight": 3, "road": true,
                   "intro": ["Two men step out onto the road ahead, blades drawn. 'Your purse, and nobody gets hurt.'", "A voice from the hedge: \"Stand still, and it stays friendly.\"", "Two of them, nervous and armed, which is the dangerous combination."]},
    "bandits": {"name": "bandits", "members": [["bandit", "1d2+1"], ["bandit_archer", "1"]], "biomes": ["any"], "danger": [2, 7], "time": "any", "weight": 3, "road": true,
                   "intro": ["Bandits: men with the look of hunger and practice, spreading out to block the road.", "A crossbow bolt thuds into a tree beside your head. Then the bandits come.", "They have felled a tree across the road, and they are waiting beside it.", "Men rise out of the ditch on both sides of the road. This was arranged."]},
    "bandit_gang": {"name": "a bandit gang", "members": [["bandit_captain", "1"], ["bandit", "1d3+1"], ["bandit_archer", "1d2"]], "biomes": ["any"], "danger": [6, 10], "time": "any", "weight": 2, "road": true,
                   "intro": ["A whole gang, with a captain in good leather giving the orders. They have done this many times before.", "A dozen of them, and a captain who counts you first and draws second.", "The whole gang, blocking the road at its narrowest, at their leisure."]},
    "thugs": {"name": "hired thugs", "members": [["thug", "2"]], "biomes": ["any"], "danger": [3, 8], "time": "night", "weight": 1, "road": true,
                   "intro": ["Two big men who have clearly been paid to do something unpleasant, and have decided it will be you.", "\"Nothing personal,\" says the bigger one, rolling his shoulder.", "Two men who have been waiting a while, and are annoyed about the wait."]},
    "deserters": {"name": "deserters", "members": [["deserter", "1d3+1"]], "biomes": ["any"], "danger": [1, 6], "time": "any", "weight": 2,
                   "intro": ["Soldiers without a banner, hollow-cheeked, spears levelled. They look more desperate than cruel.", "Men in the rags of a uniform, and they have not eaten today either.", "They hold their spears like men who were taught properly and have stopped caring."]},
    "cultists": {"name": "cultists", "members": [["cultist", "1d3+1"]], "biomes": ["forest", "marsh", "hills", "pine_forest"], "danger": [3, 8], "time": "night", "weight": 1,
                   "intro": ["Hooded figures around a fire that shouldn't be burning out here. They turn as one.", "Robed figures kneeling round something on the ground. They stand up together.", "A smell of burnt hair, a mutter of the same words over and over, and then silence as they see you."]},
    "cult_circle": {"name": "a cult circle", "members": [["cult_fanatic", "1"], ["cultist", "1d3+2"]], "biomes": ["forest", "marsh", "hills", "pine_forest"], "danger": [6, 10], "time": "night", "weight": 1,
                   "intro": ["A ring of chanting figures, and at its heart a preacher whose hands smoke.", "The chanting rises, and something in the middle of the circle answers it.", "Candles in a ring, faces above them, and the preacher smiling at you."]},
    "restless_dead": {"name": "the restless dead", "members": [["skeleton", "1d2+1"]], "biomes": ["any"], "danger": [3, 8], "time": "night", "weight": 1,
                   "intro": ["Bones rattle in the dark. Something that should be buried is walking toward you.", "The barrow mouth is open, and what came out of it is still coming.", "Dry bone on stone, from everywhere at once."]},
    "zombies": {"name": "walking corpses", "members": [["zombie", "1d3"]], "biomes": ["marsh", "forest", "plains", "hills"], "danger": [3, 8], "time": "night", "weight": 1,
                   "intro": ["The smell reaches you first: the grave, opened. Then they come shambling.", "They come out of the mist at a walk, and they do not stop walking.", "One of them is wearing what is left of a carter's coat."]},
    "ghouls": {"name": "ghouls", "members": [["ghoul", "1d2"]], "biomes": ["any"], "danger": [6, 10], "time": "night", "weight": 1,
                   "intro": ["Grey things, long-armed, loping on all fours: ghouls, and they have smelt your blood.", "Something is eating, and it has heard you, and it is no longer eating.", "Long grey fingers, and a mouth that opens further than a mouth should."]},
    "gnoll_pack": {"name": "a gnoll pack", "members": [["gnoll", "1d3+1"]], "biomes": ["plains", "hills", "forest", "tundra"], "danger": [4, 10], "time": "any", "weight": 2,
                   "intro": ["Laughter that is not laughter, from three directions at once, and then they come.", "A hyena laugh, and behind it the sound of something running on two legs.", "They have a pole with heads on it, and they are proud of it."]},
    "hobgoblin_patrol": {"name": "a hobgoblin patrol", "members": [["hobgoblin", "1d2+1"]], "biomes": ["hills", "mountains", "forest", "pine_forest"], "danger": [5, 10], "time": "any", "weight": 2,
                         "intro": ["They come down the road in step, in armour, and they have already seen you.", "A horn goes once, sharp, and the shields come up in a line.", "Armour, discipline and no discussion: a patrol, and you are in its way."]},
    "bugbear_ambush": {"name": "bugbears", "members": [["bugbear", "1d2"]], "biomes": ["forest", "pine_forest", "hills"], "danger": [5, 10], "time": "any", "weight": 1,
                       "intro": ["The undergrowth stands up, and it is holding a morningstar.", "The first you know of it is the weight of something landing behind you.", "A bugbear steps out grinning, and two more come out of the trees behind you."]},
    "berserkers": {"name": "berserkers", "members": [["berserker", "1d2"]], "biomes": ["tundra", "mountains", "hills", "pine_forest"], "danger": [6, 10], "time": "any", "weight": 1,
                   "intro": ["Men in furs and less, coming at a run, shouting one word over and over.", "They have thrown away their shields somewhere back there, and are the happier for it.", "Bare arms, painted faces, and a noise that is not a war cry so much as a laugh."]},
    "stirges": {"name": "stirges", "members": [["stirge", "1d4+2"]], "biomes": ["marsh", "forest", "any"], "danger": [2, 9], "time": "any", "weight": 1,
                "intro": ["Something drops out of the dark on leather wings, and then a dozen more do.", "A cloud comes off the rocks and turns towards the warmth of you.", "Wings, and a needle going into your neck before you have understood it."]},
    "goblins": {"name": "goblins", "members": [["goblin", "1d3+1"]], "biomes": ["hills", "mountains", "forest", "pine_forest"], "danger": [2, 7], "time": "any", "weight": 2,
                   "intro": ["Goblins pour out of a gully, shrieking and waving blades.", "Goblins, and they have a plan, and it is a bad one but there are a lot of them.", "Small, fast, filthy, and coming from three directions."]},
    "orc_raiders": {"name": "orc raiders", "members": [["orc", "1d2+1"]], "biomes": ["hills", "mountains", "tundra", "pine_forest"], "danger": [5, 10], "time": "any", "weight": 2,
                   "intro": ["Orc raiders, tusked and painted, coming at a run with axes raised.", "They have been burning something, and the smoke is still on them.", "A raiding party, unhurried, spreading out to take you from the sides."]},
    "ogre": {"name": "an ogre", "members": [["ogre", "1"]], "biomes": ["hills", "mountains", "forest", "marsh"], "danger": [6, 10], "time": "any", "weight": 1,
                   "intro": ["The ground shakes. An ogre, ten feet of stink and appetite, has seen you.", "Something has been eating cattle out here, and it is still hungry.", "An ogre with a tree for a club, and it has already picked you up with its eyes."]},
    "troll": {"name": "a troll", "members": [["troll", "1"]], "biomes": ["mountains", "high_mountains", "pine_forest", "marsh"], "danger": [8, 10], "time": "night", "weight": 1,
                   "intro": ["A troll. You have heard the stories. They are all true, and it is already running.", "The stink reaches you first. Then the long arms.", "It unfolds itself off the rock face, and keeps unfolding."]},
    "spiders": {"name": "giant spiders", "members": [["giant_spider", "1d2"]], "biomes": ["forest", "pine_forest", "marsh"], "danger": [5, 10], "time": "night", "weight": 1,
                   "intro": ["Webs between the trees, thick as rope, and something heavy moving along them.", "The web takes you across the face, and something starts down the strand towards you.", "Bundles hang in the branches, and some of them are man-sized."]},
    "barrow_wight": {"name": "the barrow's lord", "members": [["wight", "1"], ["skeleton", "1d2+1"]], "biomes": ["none"], "danger": [0, 10], "time": "any", "weight": 0,
                   "intro": ["In the deepest chamber something in rotted mail rises from its bier, and the dead around it rise too.", "Cold comes into the chamber ahead of it, and the torches go blue.", "The thing on the bier turns its head, and what is left of a crown slips."]},
    "goblin_warband": {"name": "a goblin warband", "members": [["goblin_boss", "1"], ["goblin", "1d3+2"]], "biomes": ["none"], "danger": [0, 10], "time": "any", "weight": 0,
                   "intro": ["The warren's chief, and all its kin, screaming.", "Every goblin in the place, and the chief behind them shouting.", "The warren empties into the chamber: there is no counting them."]},
    "orc_warband": {"name": "an orc warband", "members": [["orc_warchief", "1"], ["orc", "1d2+1"]], "biomes": ["none"], "danger": [0, 10], "time": "any", "weight": 0,
                   "intro": ["The warchief stands, and its guards close around it.", "Drums, and then the warchief's guards fill the passage.", "The whole band on its feet at once, and the chief already coming for you."]},
    "cult_temple": {"name": "the cult's inner circle", "members": [["cult_fanatic", "1d2"], ["cultist", "1d3+1"]], "biomes": ["none"], "danger": [0, 10], "time": "any", "weight": 0,
                   "intro": ["The chanting stops. Every hooded face turns to you.", "The preacher raises both hands, and everything in the temple looks up.", "They were waiting for you, and they have been told your name."]},
    "bandit_hideout": {"name": "the outlaws' captain", "members": [["bandit_captain", "1"], ["bandit", "1d2+1"], ["bandit_archer", "1"]], "biomes": ["none"], "danger": [0, 10], "time": "any", "weight": 0,
                   "intro": ["The captain kicks over the table and draws. \"Nobody leaves.\"", "\"Well,\" says the captain, standing slowly. \"That saves us finding you.\"", "The fire is lit, the table is laid, and every man in the room reaches for a weapon."]},
    "dragon": {"name": "the dragon", "members": [["young_dragon", "1"]], "biomes": ["none"], "danger": [0, 10], "time": "any", "weight": 0,
                   "intro": ["Gold, a mountain of it. And on the gold, the dragon.", "The heat comes first, and then an eye the size of a shield opens.", "The hoard shifts, and what you took for a wall of bronze breathes in."]}
  },
