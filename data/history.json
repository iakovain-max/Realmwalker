    "themes": {
      "myth": {
        "names": ["the Age of Myth"],
        "summary": [
          "Of the time before the records only songs and stones remain.",
          "The elder peoples were old already, and men were few."
        ]
      },
      "founding": {
        "names": ["the Age of Founding", "the Years of the First Towns", "the Settling", "the Age of Axes"],
        "summary": [
          "Forests fell to the axe and new towns rose on every river.",
          "People spread across the land, and every valley got its village."
        ]
      },
      "war": {
        "names": [
          "the Age of Strife", "the Iron Years", "the Long War", "the Age of Swords", "the Red Years",
          "the Years of Fire and Steel"
        ],
        "summary": [
          "Crowns fought crowns, and the fields were sown with the dead.",
          "There was hardly a year without a war, and few towns that did not change hands."
        ]
      },
      "dragons": {
        "names": ["the Age of Dragons", "the Burning Years", "the Years of Fire", "the Time of Wings"],
        "summary": [
          "Dragons came down from the mountains, and whole towns paid them tribute or burned.",
          "The great wyrms were awake, and nothing that was built was safe."
        ]
      },
      "beasts": {
        "names": ["the Age of Monsters", "the Dark Years", "the Years of Fear", "the Wild Time"],
        "summary": [
          "The wild crept in to the edge of every field: trolls on the bridges, raiders on the roads.",
          "Monsters and raiders ruled the roads, and the towns shut their gates at dusk."
        ]
      },
      "plague": {
        "names": ["the Plague Years", "the Grey Years", "the Age of Sorrow", "the Years of the Bell"],
        "summary": ["Sickness walked the roads, and the bells did not stop tolling.", "Plague and hunger emptied the villages."]
      },
      "heroes": {
        "names": ["the Age of Heroes", "the Age of Legends", "the Time of Champions"],
        "summary": [
          "Heroes went out against the monsters of the wild, and some of them came back.",
          "It was an age of champions, of beasts slain and treasures found."
        ]
      },
